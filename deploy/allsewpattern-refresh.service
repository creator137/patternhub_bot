[Unit]
Description=allsewpattern daily catalog refresh and backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=allsewpattern
Group=allsewpattern
WorkingDirectory=/opt/allsewpattern
EnvironmentFile=/opt/allsewpattern/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/flock -n /opt/allsewpattern/data/refresh.lock /opt/allsewpattern/.venv/bin/python -m app.refresh
TimeoutStartSec=6h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/allsewpattern/data
UMask=0077
