[Unit]
Description=allsewpattern Mini App
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=allsewpattern
Group=allsewpattern
WorkingDirectory=/opt/allsewpattern
EnvironmentFile=/opt/allsewpattern/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/allsewpattern/.venv/bin/python -m uvicorn app.web.main:create_app --factory --host 127.0.0.1 --port 8017 --no-proxy-headers
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/allsewpattern/data
UMask=0077

[Install]
WantedBy=multi-user.target
