BOT_TOKEN=
DATABASE_PATH=data/patternhub.sqlite3
LOG_LEVEL=INFO

# Mini App: production disables local browser admin access.
APP_ENV=production
ADMIN_USER_IDS=
# Bootstrap verified usernames on first Telegram login; their stable IDs are pinned in SQLite.
ADMIN_USERNAMES=
MINIAPP_URL=
MEDIA_CACHE_MAX_MB=768
# Additional trusted CDN hostnames for future providers, comma-separated.
MEDIA_ALLOWED_HOSTS=
# Local-only: APP_ENV=local + random key >=32 chars. Never expose through a tunnel.
MINIAPP_DEV_KEY=

# Subscriptions: configure this project's own shop, never reuse tarot secrets.
BOT_USERNAME=
PAYMENTS_ENABLED=false
YOOKASSA_MODE=test
YOOKASSA_SHOP_ID_TEST=
YOOKASSA_SECRET_KEY_TEST=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Set true only after test checkout, seller terms, fiscal receipts and launch approval.
# This implementation assumes receipts are handled by an approved external fiscal setup.
YOOKASSA_LIVE_APPROVED=false
